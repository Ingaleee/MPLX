<Project Sdk="Microsoft.NET.Sdk">
    <ItemGroup>
        <ProjectReference Include="..\..\Infrastructure\Mplx.DotNet\Mplx.DotNet.csproj" />
        <None
            Include="$(MplxNativePath)"
            Link="$(MplxNativeFileName)"
            CopyToOutputDirectory="PreserveNewest"
            Condition="'$(MplxNativePath)' != ''"
        />
    </ItemGroup>
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
</Project>
