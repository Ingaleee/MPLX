{
    "name": "mplx",
    "displayName": "MPLX Language",
    "description": "Compiler-backed MPLX diagnostics, navigation and refactoring.",
    "version": "0.6.0",
    "private": true,
    "publisher": "ingaleee",
    "repository": {
        "type": "git",
        "url": "https://github.com/Ingaleee/MPLX.git",
        "directory": "Presentation/vscode-mplx"
    },
    "engines": {
        "vscode": "^1.87.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "activationEvents": [
        "onLanguage:mplx"
    ],
    "main": "dist/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "mplx",
                "extensions": [
                    ".mplx"
                ],
                "aliases": [
                    "MPLX"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "mplx",
                "scopeName": "source.mplx",
                "path": "./syntaxes/mplx.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "mplx.restartServer",
                "title": "MPLX: Restart Language Server"
            }
        ],
        "configuration": {
            "title": "MPLX",
            "properties": {
                "mplx.cliPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to the MPLX compiler. Relative paths resolve from the workspace. Empty selects a build automatically."
                }
            }
        }
    },
    "scripts": {
        "build": "tsc -p . && node scripts/copy-server.mjs",
        "vscode:prepublish": "npm run build"
    },
    "dependencies": {
        "vscode-languageclient": "9.0.1",
        "vscode-languageserver": "9.0.1",
        "vscode-languageserver-textdocument": "1.0.11"
    },
    "devDependencies": {
        "typescript": "^5.4.0",
        "@types/vscode": "1.87.0",
        "@types/node": "^20.14.0"
    }
}
