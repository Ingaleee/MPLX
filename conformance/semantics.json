{
    "schema_version": 1,
    "semantics_version": 1,
    "rules": [
        {
            "id": "T01",
            "normative": "Literals are i64. Unannotated parameters and returns default to i32. Unannotated let infers its initializer type."
        },
        {
            "id": "T02",
            "normative": "Integer arithmetic is checked at the result width; mixed integer operands promote to i64."
        },
        {
            "id": "T03",
            "normative": "Signed division truncates toward zero. Remainder has the dividend sign. Zero divisor traps."
        },
        {
            "id": "T04",
            "normative": "The i64 carrier rejects MIN/-1 for division and remainder. i32 MIN/-1 division traps, but remainder is zero."
        },
        {
            "id": "T05",
            "normative": "Implicit integer narrowing checks i32 range at assignment, argument and return conversion."
        },
        {
            "id": "T06",
            "normative": "bool is distinct. Explicit bool(integer) maps nonzero to one; explicit integer(bool) maps to zero or one."
        },
        {
            "id": "E01",
            "normative": "Operands and call arguments evaluate left to right. Each argument converts before the next argument evaluates."
        },
        {
            "id": "E02",
            "normative": "Logical operators short-circuit and return bool. Numeric conditions use nonzero truthiness."
        },
        {
            "id": "E03",
            "normative": "Checked computations and potentially trapping or nonterminating calls remain observable even when their values are unused."
        },
        {
            "id": "E04",
            "normative": "Arithmetic faults report the source expression or conversion and containing function. Parentheses do not expand an inner expression range."
        },
        {
            "id": "S01",
            "normative": "Lexical scopes allow shadowing. Initializers resolve before the new binding is installed. Each loop iteration creates its body scope."
        },
        {
            "id": "S02",
            "normative": "Symbols in one scope are unique. A local binding can hide a callable function."
        },
        {
            "id": "S03",
            "normative": "Static errors are checked in unreachable source before optimization."
        },
        {
            "id": "F01",
            "normative": "Missing return produces typed zero. Functions may be called before declaration and may recurse."
        },
        {
            "id": "F02",
            "normative": "Host arguments must match arity and typed carriers. bool accepts only 0 or 1, i32 only its signed range."
        },
        {
            "id": "P01",
            "normative": "Operator precedence and associativity follow the scalar v1 grammar."
        }
    ],
