fn sum(n: i64) -> i64 {
    let i = 1;
    let total = 0;
    while (i <= n) {
        total = total + i;
        i = i + 1;
    }
    return total;
}
fn main() -> i64 {
    let n = 100;
    if (true) {
        let n = n + 1;
        n = n + 1;
    }
    if (false && (1 / 0)) {
        return -1;
    }
    return sum(n);
}
