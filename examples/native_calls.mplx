// Native calls and mutual recursion; result: 17711.
fn fib(n: i64) -> i64 {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}
fn even(n: i64) -> bool {
    if (n == 0) {
        return true;
    }
    return odd(n - 1);
}
fn odd(n: i64) -> bool {
    if (n == 0) {
        return false;
    }
    return even(n - 1);
}
fn main() -> i64 {
    let answer: i32 = fib(22);
    if (even(12)) {
        return answer;
    }
    return -1;
}
