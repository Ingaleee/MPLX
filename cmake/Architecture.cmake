# Fail configuration when the core target dependency graph violates layer ownership.
function(mplx_check_dependencies target)
    get_target_property(actual ${target} LINK_LIBRARIES)
    if(NOT actual)
        return()
    endif()
    foreach(dependency IN LISTS actual)
        if(NOT dependency IN_LIST ARGN)
            message(FATAL_ERROR "Architecture violation: ${target} -> ${dependency}")
        endif()
    endforeach()
endfunction()
mplx_check_dependencies(mplx-lang)
mplx_check_dependencies(mplx-reference mplx-lang)
mplx_check_dependencies(mplx-compiler mplx-lang)
mplx_check_dependencies(mplx-vm mplx-compiler mplx-jit)
if(TARGET mplx-jit)
    mplx_check_dependencies(mplx-jit mplx-compiler)
endif()
