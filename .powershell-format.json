{
    "IncludeRules": [
        "PSPlaceOpenBrace",
        "PSPlaceCloseBrace",
        "PSUseConsistentIndentation",
        "PSUseConsistentWhitespace",
        "PSAlignAssignmentStatement"
    ],
    "Rules": {
        "PSPlaceOpenBrace": {
            "Enable": true,
            "OnSameLine": true,
            "NewLineAfter": true,
            "IgnoreOneLineBlock": false
        },
        "PSPlaceCloseBrace": {
            "Enable": true,
            "NewLineAfter": true,
            "NoEmptyLineBefore": true,
            "IgnoreOneLineBlock": false
        },
        "PSUseConsistentIndentation": {
            "Enable": true,
            "Kind": "space",
            "IndentationSize": 4,
            "PipelineIndentation": "IncreaseIndentationForFirstPipeline"
        },
        "PSUseConsistentWhitespace": {
            "Enable": true,
            "CheckInnerBrace": true,
            "CheckOpenBrace": true,
            "CheckOpenParen": true,
            "CheckOperator": true,
            "CheckSeparator": true,
            "CheckParameter": true
        },
        "PSAlignAssignmentStatement": {
            "Enable": false
        }
    }
}
